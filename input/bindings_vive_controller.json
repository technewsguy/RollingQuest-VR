{
  "controller_type": "vive_controller",
  "description": "Rolling Quest VR default: trackpads as sticks, triggers, grips and menu buttons",
  "name": "Rolling Quest VR default",
  "bindings": {
    "/actions/rqvr": {
      "sources": [
        { "path": "/user/hand/left/input/trackpad", "mode": "trackpad",
          "inputs": { "position": { "output": "/actions/rqvr/in/stick_l" }, "click": { "output": "/actions/rqvr/in/stickclick_l" } } },
        { "path": "/user/hand/right/input/trackpad", "mode": "trackpad",
          "inputs": { "position": { "output": "/actions/rqvr/in/stick_r" }, "click": { "output": "/actions/rqvr/in/a_r" } } },
        { "path": "/user/hand/left/input/trigger", "mode": "trigger",
          "inputs": { "pull": { "output": "/actions/rqvr/in/trigger_l" } } },
        { "path": "/user/hand/right/input/trigger", "mode": "trigger",
          "inputs": { "pull": { "output": "/actions/rqvr/in/trigger_r" } } },
        { "path": "/user/hand/left/input/grip", "mode": "button", "inputs": { "click": { "output": "/actions/rqvr/in/a_l" } } },
        { "path": "/user/hand/right/input/grip", "mode": "button", "inputs": { "click": { "output": "/actions/rqvr/in/b_r" } } },
        { "path": "/user/hand/left/input/application_menu", "mode": "button", "inputs": { "click": { "output": "/actions/rqvr/in/b_l" } } },
        { "path": "/user/hand/right/input/application_menu", "mode": "button", "inputs": { "click": { "output": "/actions/rqvr/in/b_l" } } }
      ]
    }
  }
}
